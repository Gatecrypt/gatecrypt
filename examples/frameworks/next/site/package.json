{
  "name": "@gatecrypt/example-next-site",
  "version": "0.1.0",
  "private": true,
  "description": "A Next.js site, exported as static files and protected by Gatecrypt, that calls an API which knows who the visitor is",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && gatecrypt encrypt out --no-spa-fallback"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gatecrypt": "workspace:*",
    "typescript": "^7.0.2"
  }
}
