{
  "name": "@gatecrypt/example-sveltekit-site",
  "version": "0.1.0",
  "private": true,
  "description": "A SvelteKit site built with adapter-static, protected by Gatecrypt, that calls an API which knows who the visitor is",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && gatecrypt encrypt build --no-spa-fallback"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "gatecrypt": "workspace:*",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
